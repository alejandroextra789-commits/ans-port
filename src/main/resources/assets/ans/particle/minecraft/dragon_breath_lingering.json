{
 "format": "ans:bedrock_particle",
 "format_version": 1,
 "identifier": "minecraft:dragon_breath_lingering",
 "source": {
  "layer": "root",
  "file": "particles/efh.json",
  "format_version": "1.10.0"
 },
 "material": "particles_blend",
 "render": "blend",
 "bedrock_texture": "textures/particle/particles",
 "texture": "ans:textures/particle_fx/particle/particles.png",
 "texture_size": [
  128,
  128
 ],
 "components": {
  "minecraft:emitter_rate_instant": {
   "num_particles": "Math.max(v.cloud_radius*v.particle_multiplier,2)"
  },
  "minecraft:emitter_lifetime_once": {
   "active_time": "v.cloud_lifetime"
  },
  "minecraft:emitter_shape_disc": {
   "radius": "v.cloud_radius",
   "direction": [
    "Math.random(-1,1)",
    0.5,
    "Math.random(-1,1)"
   ]
  },
  "minecraft:particle_lifetime_expression": {
   "max_lifetime": "Math.random(1,3)"
  },
  "minecraft:particle_initial_spin": {
   "rotation": "Math.random_integer(0,3)*90"
  },
  "minecraft:particle_initial_speed": "Math.random(0,1)",
  "minecraft:particle_motion_dynamic": {
   "linear_drag_coefficient": 0.5
  },
  "minecraft:particle_appearance_billboard": {
   "size": [
    "1+v.particle_random_1",
    "1+v.particle_random_1"
   ],
   "facing_camera_mode": "emitter_transform_xz",
   "uv": {
    "texture_width": 128,
    "texture_height": 128,
    "uv": [
     "32+Math.round(v.particle_random_2*2)*8",
     0
    ],
    "uv_size": [
     8,
     8
    ]
   }
  },
  "minecraft:particle_appearance_tinting": {
   "color": {
    "interpolant": "v.particle_age/v.particle_lifetime",
    "gradient": {
     "0.0": "#00000000",
     "0.5": "#75EA00FF",
     "1.0": "#00EA00FF"
    }
   }
  }
 }
}